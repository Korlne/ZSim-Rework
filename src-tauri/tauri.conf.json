{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-test/refs/heads/t2/test-app/gen/schemas/desktop-schema.json",
  "productName": "ZSim Analyzer",
  "version": "0.1.0",
  "identifier": "com.zsim.analyzer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ZSim Analyzer",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../data/**/*.json",
      "../analysis_sidecar.py"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": null
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["python3", "python3-pip"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
