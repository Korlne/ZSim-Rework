{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability granting shell, dialog, and IPC permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "url": "http://*",
          "app": "*"
        }
      ]
    },
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
